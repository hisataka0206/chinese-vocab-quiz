# Copy this file to `.env` and fill in the values.
# `.env` is gitignored and must not be committed.

# Notion integration token (from https://www.notion.so/my-integrations)
NOTION_TOKEN=

# Notion database ID for the Chinese dictionary.
# Accepts either the raw UUID or the full URL fragment; the script strips "?v=..." automatically.
NOTION_CHINESE_DICT_ID=
